    "# Monthly energy in MWh = mean kW for the month × 24 h × days in the month ÷ 1000\n",
    "# ('MS' = group by month, labelled by the month's start date; the minute count ÷ 1440 gives days in the month)\n",
    "monthly = (df[['Light', 'Plug', 'AC']].resample('MS').mean() * 24 *\n",
    "           df.index.to_series().resample('MS').count().div(1440).values[:, None]) / 1000\n",
    "\n",
    "# Stacked bar chart: draw AC first, then Light on top of it, then Plug on top of that\n",
    "fig, ax = plt.subplots(figsize=(12, 4.5))\n",
    "bottom = np.zeros(len(monthly))                  # running height where the next layer starts\n",
    "for c in ['AC', 'Light', 'Plug']:\n",
    "    ax.bar(monthly.index.strftime('%b %y'), monthly[c], bottom=bottom, color=C[c], label=c,\n",
    "           edgecolor='white', linewidth=1.5)     # thin white edge separates the stacked layers\n",
    "    bottom += monthly[c].values                  # raise the base for the next layer\n",
    "ax.set_ylabel('MWh / month'); ax.legend(frameon=False, ncol=3)\n",
    "ax.set_title('Floor 1 — monthly energy by end-use')\n",
    "plt.xticks(rotation=45); plt.tight_layout(); plt.show()\n",
    "monthly.assign(Total=monthly.sum(axis=1)).round(2).T   # same numbers as a table, with a Total row"
   ]
