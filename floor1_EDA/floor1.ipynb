   "source": [
    "# Break each column name like 'z2_AC1(kW)' into its parts so we can group meters later\n",
    "schema = pd.DataFrame({\n",
    "    'zone':    [c.split('_')[0] for c in POWER_COLS],                      # 'z2'\n",
    "    'end_use': [c.split('_')[1].replace('(kW)', '') for c in POWER_COLS],  # 'AC1'\n",
    "}, index=POWER_COLS)\n",
    "\n",
    "# 'category' drops the unit number, so AC1..AC4 all become 'AC' (Light and Plug are unchanged)\n",
    "schema['category'] = schema['end_use'].str.replace(r'\\d+', '', regex=True)\n",
    "\n",
    "print(raw[POWER_COLS].dtypes.value_counts())   # confirm every meter column is numeric (float64)\n",
    "schema"
   ]
  },
