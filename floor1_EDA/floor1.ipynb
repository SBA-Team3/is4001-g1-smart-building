    "# % of minutes missing (NaN) for each meter, calculated separately for each year.\n",
    "# .isna() gives True/False per cell; the mean of True/False = share of True; ×100 makes it a percentage.\n",
    "miss = pd.DataFrame({\n",
    "    y: raw.loc[raw.year == y, POWER_COLS].isna().mean() * 100 for y in FILES\n",
    "}).round(2)\n",
    "miss.columns = [f'{y} % missing' for y in FILES]\n",
    "miss['overall % missing'] = (raw[POWER_COLS].isna().mean() * 100).round(2)\n",
    "miss.sort_values('overall % missing', ascending=False)   # worst meter at the top"
   ]
  },
