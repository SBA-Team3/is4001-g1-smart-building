    "# z2_Light drops sharply at some point, so plot its daily mean to see it\n",
    "z2l = df['z2_Light(kW)'].resample('D').mean()\n",
    "fig, ax = plt.subplots(figsize=(12, 3.8))\n",
    "ax.plot(z2l.index, z2l, color=C['Light'])\n",
    "ax.set_ylabel('daily mean kW'); ax.set_title('z2_Light — daily mean')\n",
    "ax.xaxis.set_major_formatter(mdates.DateFormatter('%b %y'))\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "# Simple change-point detection: try every week as a split point and pick the one where the mean\n",
    "# before vs after differs the most. Weekly means are used so single noisy days don't dominate.\n",
    "w = df['z2_Light(kW)'].resample('W').mean().dropna()\n",
    "# score each candidate split i (skip the first/last 4 weeks so each side has enough data)\n",
    "scores = {w.index[i]: abs(w.iloc[:i].mean() - w.iloc[i:].mean()) for i in range(4, len(w) - 4)}\n",
    "cp = max(scores, key=scores.get)       # the week with the biggest before/after difference\n",
    "print(f\"Most likely step change: week ending {cp.date()}  |  \"\n",
    "      f\"before ≈ {w[:cp].iloc[:-1].mean():.1f} kW, after ≈ {w[cp:].mean():.1f} kW\")"
   ]
  },
