   "source": [
    "# Which meters rise and fall together? Correlate hourly averages (minute data is too noisy),\n",
    "# leaving out the dead AC3/AC4 meters, which carry no signal\n",
    "live = [c for c in POWER_COLS if c not in ('z2_AC3(kW)', 'z2_AC4(kW)')]\n",
    "hourly = df[live].resample('h').mean()          # 'h' = group by hour\n",
    "corr = hourly.corr()                            # Pearson r for every pair: +1 move together, −1 opposite, 0 unrelated\n",
    "\n",
    "# Heatmap of the correlation matrix: red = positive, blue = negative, white = none\n",
    "fig, ax = plt.subplots(figsize=(8, 6.5))\n",
    "im = ax.imshow(corr, cmap='RdBu_r', vmin=-1, vmax=1)\n",
    "ax.set_xticks(range(len(live)), live, rotation=90); ax.set_yticks(range(len(live)), live)\n",
    "for i in range(len(live)):                      # write the r value in every cell\n",
    "    for j in range(len(live)):\n",
    "        ax.text(j, i, f'{corr.iloc[i, j]:.2f}', ha='center', va='center', fontsize=7,\n",
    "                color='white' if abs(corr.iloc[i, j]) > .6 else '#0b0b0b')   # white text on dark cells\n",
    "ax.grid(False); fig.colorbar(im, ax=ax, shrink=.8)\n",
    "ax.set_title('Floor 1 — correlation of hourly mean load')\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
