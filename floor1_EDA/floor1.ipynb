    "# List the strongest pairs. The matrix is symmetric (A-B = B-A), so keep only the upper triangle\n",
    "# (np.triu, k=1 also drops the diagonal where each meter correlates 1.0 with itself), then sort by strength\n",
    "pairs = corr.where(np.triu(np.ones(corr.shape, bool), 1)).stack().sort_values(key=abs, ascending=False)\n",
    "pairs.head(8).round(2).rename('r').to_frame()"
   ]
