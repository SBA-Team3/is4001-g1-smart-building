    "ax.set_yticks(range(7), ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'])\n",
    "ax.set_xticks(range(24)); ax.set_xlabel('Hour of day (shifted −7 h)'); ax.grid(False)\n",
    "fig.colorbar(im, ax=ax, label='mean kW')\n",
    "ax.set_title('Floor 1 — average total load, timestamps shifted −7 h')\n",
    "plt.tight_layout(); plt.show()"
   ]
