    "df = raw.copy()                                        # work on a copy so `raw` stays untouched for comparison\n",
    "\n",
    "df[POWER_COLS] = df[POWER_COLS].mask(spikes)          # mask(): replace every flagged spike with NaN\n",
    "\n",
    "# Fill short gaps by drawing a straight line between the readings on either side.\n",
    "#   limit=60           -> fill at most 60 consecutive missing minutes (longer outages stay NaN)\n",
    "#   limit_area='inside' -> only fill gaps that have real data on both sides\n",
    "df[POWER_COLS] = df[POWER_COLS].interpolate(method='time', limit=60, limit_area='inside')\n",
    "\n",
    "print('NaNs before cleaning:', int(raw[POWER_COLS].isna().sum().sum()))\n",
    "print('NaNs after  cleaning:', int(df[POWER_COLS].isna().sum().sum()))\n",
    "\n",
    "# Build a dict of category -> list of its meters, e.g. {'AC': ['z2_AC1(kW)', ..., 'z2_AC4(kW)'], ...}\n",
    "cat_cols = {cat: schema.index[schema.category == cat].tolist() for cat in ['Light', 'Plug', 'AC']}\n",
    "\n",
    "# New columns: total kW per category. min_count=len(cols) makes the sum NaN if ANY meter in the group is\n",
    "# missing, so a total is never silently too low because one part is missing.\n",
    "for cat, cols in cat_cols.items():\n",
    "    df[cat] = df[cols].sum(axis=1, min_count=len(cols))\n",
    "df['Total'] = df[['Light', 'Plug', 'AC']].sum(axis=1, min_count=3)   # whole-floor total kW\n",
    "cat_cols"
   ]
  },
