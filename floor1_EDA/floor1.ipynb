    "fig, ax = plt.subplots(figsize=(13, 4.5))\n",
    "# imshow draws the table as a heatmap: rows = meters, columns = days, darker = more missing\n",
    "im = ax.imshow(daily_miss.T.values, aspect='auto', cmap='Blues', vmin=0, vmax=100, interpolation='nearest')\n",
    "ax.set_yticks(range(len(POWER_COLS)), POWER_COLS)\n",
    "ticks = np.where(daily_miss.index.day == 1)[0]    # put an x-axis label on the 1st of each month\n",
    "ax.set_xticks(ticks, daily_miss.index[ticks].strftime('%b\\n%y'), rotation=0)\n",
    "ax.grid(False)                                    # gridlines look messy on a heatmap\n",
    "fig.colorbar(im, ax=ax, label='% of day missing')\n",
    "ax.set_title('Floor 1 — daily missingness by meter')\n",
    "plt.tight_layout(); plt.show()"
   ]
