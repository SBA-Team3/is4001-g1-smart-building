   "source": [
    "# Only AC1 and AC2 ever meaningfully run. How often is each one on, alone or together?\n",
    "ON = 1.0                                                   # treat a unit drawing > 1 kW as \"running\"\n",
    "ac_on = df[['z2_AC1(kW)', 'z2_AC2(kW)']].gt(ON)            # True/False per minute per unit\n",
    "\n",
    "# Build a text label per minute, e.g. 'AC1' + '+AC2' = 'AC1+AC2', then rename to readable states\n",
    "state = (ac_on['z2_AC1(kW)'].map({True: 'AC1', False: ''}) + ac_on['z2_AC2(kW)'].map({True: '+AC2', False: ''})) \\\n",
    "    .replace({'': 'both off', '+AC2': 'AC2 only', 'AC1': 'AC1 only', 'AC1+AC2': 'both on'})\n",
    "state.value_counts(normalize=True).mul(100).round(1).rename('% of minutes').to_frame()   # % of time in each state"
   ]
  },
