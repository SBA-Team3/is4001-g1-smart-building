    "# Find outage \"blocks\": consecutive minutes where EVERY meter is NaN (i.e. the whole logger was down)\n",
    "all_na = raw[POWER_COLS].isna().all(axis=1)          # True for a minute if all meters are missing\n",
    "\n",
    "# Trick to label consecutive runs: the id increases by 1 every time the value flips True<->False,\n",
    "# so each unbroken stretch of True (or False) gets its own number\n",
    "block_id = (all_na != all_na.shift()).cumsum()\n",
    "\n",
    "# Keep only the True runs, and for each one record when it started, ended, and how many minutes it lasted\n",
    "blocks = (all_na[all_na].groupby(block_id[all_na])\n",
    "          .agg(start=lambda s: s.index.min(), end=lambda s: s.index.max(), minutes='size'))\n",
    "print(f'Rows with ALL meters missing: {all_na.sum():,}  in {len(blocks)} blocks')\n",
    "blocks.sort_values('minutes', ascending=False).head(10).reset_index(drop=True)   # 10 longest outages"
   ]
  },
