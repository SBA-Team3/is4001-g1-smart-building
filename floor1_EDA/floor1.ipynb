    "# --- Spike detection. A reading counts as a spike only if ALL three conditions hold. ---\n",
    "\n",
    "# Condition 1: the value is more than 3× the meter's 99.9th percentile (i.e. far above its normal maximum)\n",
    "q999 = raw[POWER_COLS].quantile(0.999)\n",
    "SPIKE_CAP = (3 * q999).clip(lower=1.0)   # minimum cap of 1 kW, so near-zero meters (AC3/AC4) aren't over-flagged\n",
    "exceed = raw[POWER_COLS].gt(SPIKE_CAP)   # True where a reading is above its meter's cap\n",
    "\n",
    "# Condition 2: the excursion is short (≤ 3 consecutive minutes). A real device switching on stays high for longer.\n",
    "def short_runs(m, max_len=3):\n",
    "    run_id = (m != m.shift()).cumsum()                                  # label consecutive True/False runs\n",
    "    return m & (m.groupby(run_id).transform('size') <= max_len)         # keep only True runs of length ≤ max_len\n",
    "\n",
    "# Condition 3: the surrounding 31-min median is normal (below cap/3), so brief crossings of the cap\n",
    "# during a genuine high-load period are kept\n",
    "context_ok = raw[POWER_COLS].rolling('31min', center=True).median().lt(SPIKE_CAP / 3)\n",
    "\n",
    "spikes = exceed.apply(short_runs) & context_ok   # final True/False table: True = spike, remove it\n",
    "\n",
    "print('Spike cap per meter (kW):'); print(SPIKE_CAP.round(1).to_string())\n",
    "print()\n",
    "# Compare how many readings were above the cap vs how many the full rule actually flags\n",
    "print(pd.DataFrame({'above cap': exceed.sum(), 'flagged as spike': spikes.sum()})[lambda d: d['above cap'] > 0].to_string())\n",
    "raw.loc[spikes.any(axis=1), POWER_COLS].round(2)   # show every minute that contains at least one flagged spike"
   ]
  },
