    "# Convert power (kW) into daily energy (kWh): average kW over the day × 24 hours.\n",
    "# If more than 10% of a day's minutes are missing, return NaN for that day instead of an average that's too low.\n",
    "def daily_kwh(s):\n",
    "    ok = s.notna().resample('D').mean() >= 0.9          # True for days with ≥ 90% of minutes present\n",
    "    return (s.resample('D').mean() * 24).where(ok)      # .where(ok) sets the other days to NaN\n",
    "\n",
    "daily = pd.DataFrame({c: daily_kwh(df[c]) for c in ['Light', 'Plug', 'AC', 'Total']})\n",
    "\n",
    "# One line per end-use across the full 18 months\n",
    "fig, ax = plt.subplots(figsize=(13, 4.5))\n",
    "for c in ['Light', 'Plug', 'AC']:\n",
    "    ax.plot(daily.index, daily[c], color=C[c], label=c)\n",
    "ax.set_ylabel('kWh / day'); ax.legend(frameon=False, ncol=3, loc='upper right')\n",
    "ax.set_title('Floor 1 — daily energy by end-use')\n",
    "ax.xaxis.set_major_formatter(mdates.DateFormatter('%b %y'))   # x labels like 'Jul 18'\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
