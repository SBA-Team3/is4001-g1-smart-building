    "# z2_Plug has much more missing data in 2018 than anything else. Same run-labelling trick as above,\n",
    "# but for this single meter, to find where its long outage is\n",
    "z2p = raw['z2_Plug(kW)'].isna()\n",
    "bid = (z2p != z2p.shift()).cumsum()\n",
    "z2p_blocks = (z2p[z2p].groupby(bid[z2p])\n",
    "              .agg(start=lambda s: s.index.min(), end=lambda s: s.index.max(), minutes='size'))\n",
    "# Show the 3 longest gaps, with length converted to days (1440 minutes per day)\n",
    "z2p_blocks.sort_values('minutes', ascending=False).head(3).assign(days=lambda d: (d.minutes / 1440).round(1))"
   ]
