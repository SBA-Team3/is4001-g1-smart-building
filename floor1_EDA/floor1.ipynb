    "DATA_DIR = '../data'   # the CSVs sit in data/, one folder up from workspace/\n",
    "FILES = {2018: '2018Floor1.csv', 2019: '2019Floor1.csv'}   # year -> file name\n",
    "\n",
    "frames = []                                   # we'll collect one DataFrame per year here\n",
    "for year, fname in FILES.items():\n",
    "    # Read the CSV; parse_dates turns the 'Date' text column into real datetime values\n",
    "    d = pd.read_csv(os.path.join(DATA_DIR, fname), parse_dates=['Date'])\n",
    "    d['year'] = year                          # tag each row with its source year (handy for filtering)\n",
    "    frames.append(d)\n",
    "    print(f\"{fname}: {d.shape[0]:,} rows × {d.shape[1]-1} cols\")   # -1 so the added 'year' col isn't counted\n",
    "\n",
    "# Sanity check: both years must have identical columns, otherwise stacking them would misalign data\n",
    "assert list(frames[0].columns) == list(frames[1].columns), 'column mismatch between years'\n",
    "\n",
    "# Stack 2018 on top of 2019, make the timestamp the row index (enables time-based slicing/resampling), sort by time\n",
    "raw = pd.concat(frames, ignore_index=True).set_index('Date').sort_index()\n",
    "\n",
    "# All meter columns end in '(kW)' — keep that list so we don't accidentally include 'year' in calculations\n",
    "POWER_COLS = [c for c in raw.columns if c.endswith('(kW)')]\n",
    "print('\\nCombined:', raw.shape)\n",
    "print('Power columns:', POWER_COLS)\n",
    "raw.head()   # show the first 5 rows"
   ]
  },
