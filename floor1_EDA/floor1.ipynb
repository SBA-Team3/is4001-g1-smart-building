   "source": [
    "# Timestamp-offset test: pretend the clock is off by s hours, then check whether the data looks like an office.\n",
    "# Two 'office-ness' signals:\n",
    "#   1) weekday ÷ weekend load during 09–17   (a real office → above 1: busier on weekdays)\n",
    "#   2) weekday 09–17 ÷ weekday 00–05 load    (a real office → well above 1: busier by day than at night)\n",
    "tot = df['Total'].dropna()\n",
    "rows = []\n",
    "for s in range(-12, 13):                              # try every shift from −12 h to +12 h\n",
    "    idx = tot.index + pd.Timedelta(hours=s)           # shifted timestamps (the data itself is unchanged)\n",
    "    h, wd = idx.hour, idx.dayofweek < 5               # hour of day and is-weekday, using the shifted clock\n",
    "    work, night = (h >= 9) & (h < 17), h < 5          # True/False masks for working hours and night\n",
    "    rows.append({'shift_h': s,\n",
    "                 'weekday/weekend (09–17)': tot[work & wd].mean() / tot[work & ~wd].mean(),\n",
    "                 'day/night (weekdays)':   tot[work & wd].mean() / tot[night & wd].mean()})\n",
    "shift_test = pd.DataFrame(rows).set_index('shift_h')\n",
    "\n",
    "# Plot both ratios against the shift; the best shift is where both are clearly above 1\n",
    "fig, ax = plt.subplots(figsize=(11, 3.8))\n",
    "for col, colour in zip(shift_test.columns, [C['Light'], C['Plug']]):\n",
    "    ax.plot(shift_test.index, shift_test[col], color=colour, linewidth=2, marker='o', markersize=4, label=col)\n",
    "ax.axhline(1, color='#52514e', linewidth=.8, linestyle='--')   # ratio = 1 reference line\n",
    "ax.axvline(0, color='#52514e', linewidth=.8)                   # 'no shift' reference line\n",
    "ax.set_xticks(range(-12, 13, 2)); ax.set_xlabel('hours added to timestamps'); ax.set_ylabel('ratio')\n",
    "ax.legend(frameon=False); ax.set_title('Which clock shift makes Floor 1 look like an office?')\n",
    "plt.tight_layout(); plt.show()\n",
    "shift_test.round(2).loc[[-8, -7, -6, 0]]   # show the most interesting rows as numbers"
   ]
  },
