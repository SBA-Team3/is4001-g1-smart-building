    "# Redraw the weekday × hour heatmap with the clock shifted back 7 h (the UTC+7 hypothesis), to compare by eye\n",
    "TZ_SHIFT_H = -7\n",
    "tmp = df[['Total']].copy()\n",
    "tmp.index = tmp.index + pd.Timedelta(hours=TZ_SHIFT_H)     # shift only this temporary copy, not df\n",
    "heat_s = tmp.pivot_table(index=tmp.index.dayofweek, columns=tmp.index.hour, values='Total', aggfunc='mean')\n",
