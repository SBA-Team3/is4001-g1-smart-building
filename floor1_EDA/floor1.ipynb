    "# Same idea, rolled up two ways: by zone (z1..z4) and by end-use (Light/Plug/AC)\n",
    "zone_kw = df[POWER_COLS].mean().groupby(schema['zone']).sum()   # sum the meters' means within each zone\n",
    "cat_kw = df[['Light', 'Plug', 'AC']].mean()                      # category totals built in section 5\n",
    "# display() shows both tables (a cell otherwise only shows its last result); share formatted as a percentage\n",
    "display(pd.DataFrame({'mean kW': zone_kw.round(1), 'share': (zone_kw / zone_kw.sum()).map('{:.0%}'.format)}))\n",
    "display(pd.DataFrame({'mean kW': cat_kw.round(1), 'share': (cat_kw / cat_kw.sum()).map('{:.0%}'.format)}))"
   ]
  },
