    "yoy.columns = ['H2 2018 kW', 'H2 2019 kW']\n",
    "yoy['change %'] = ((yoy['H2 2019 kW'] / yoy['H2 2018 kW'] - 1) * 100).round(1)   # negative = less power in 2019\n",
    "yoy.round(2)"
