    "# Compare working-hours load with night-time load\n",
    "work = df.between_time('09:00', '17:00')     # rows between 09:00 and 17:00 (any day)\n",
    "night = df.between_time('00:00', '05:00')    # rows between midnight and 05:00\n",
    "wk = work[work.index.dayofweek < 5]          # working hours on weekdays only\n",
    "\n",
    "# Mean kW in each window, plus the ratio night ÷ day (a normal office should be well below 1)\n",
    "pd.DataFrame({'weekday 09–17 mean kW': wk[['Light', 'Plug', 'AC', 'Total']].mean(),\n",
    "              'night 00–05 mean kW': night[['Light', 'Plug', 'AC', 'Total']].mean()}).round(1) \\\n",
    "  .assign(**{'night / day ratio': lambda d: (d.iloc[:, 1] / d.iloc[:, 0]).round(2)})"
   ]
