{
  "$description": "Design tokens for the CU-BEMS FM dashboard. Dark mode only (light variants are specified in DESIGN.md but not built). dashboard/ui.py reads this file, so change a value here rather than in page code. See dashboard/DESIGN.md.",
  "$figma": "https://www.figma.com/design/gDQN41sGJmdXJTwwI6vzTd",
  "mode": "dark",
  "color": {
    "bg/page": "#0F1113",
    "bg/surface": "#171A1D",
    "bg/raised": "#202428",
    "bg/control": "#282D32",
    "bg/accent-subtle": "#12343A",
    "border/default": "#30363C",
    "border/strong": "#626C77",
    "text/primary": "#ECEFF2",
    "text/secondary": "#AEB6BF",
    "text/muted": "#8E97A1",
    "text/on-accent": "#0B0D0F",
    "accent/default": "#2EB4C8",
    "accent/hover": "#5CCBDB",
    "status/critical": "#F0524F",
    "status/critical-text": "#FF8E8A",
    "status/critical-bg": "#3B1B1C",
    "status/warning": "#F2A516",
    "status/warning-text": "#FFC453",
    "status/warning-bg": "#382B11",
    "status/normal": "#3FAE6E",
    "status/normal-text": "#72D198",
    "status/normal-bg": "#15301F",
    "status/offline": "#8E97A1",
    "status/offline-text": "#B9C1CA",
    "status/offline-bg": "#23272C",
    "status/good": "#3FAE6E",
    "status/good-text": "#72D198",
    "status/good-bg": "#15301F",
    "status/neutral": "#8E97A1",
    "status/neutral-text": "#B9C1CA",
    "status/neutral-bg": "#23272C",
    "data/primary": "#4F8DF6",
    "data/series-2": "#D8C08F",
    "data/series-3": "#A6CBFB",
    "data/context": "#5A636D",
    "data/seq-1": "#24406E",
    "data/seq-2": "#3567B8",
    "data/seq-3": "#4F8DF6",
    "data/seq-4": "#86B4F8",
    "data/seq-5": "#BBD7FD"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "full": 999
  },
  "font": {
    "family": "Inter",
    "styles": {
      "Display/Hero": {
        "size": 40,
        "weight": 600,
        "lineHeight": 48,
        "letterSpacing": -0.5
      },
      "Display/Metric": {
        "size": 28,
        "weight": 600,
        "lineHeight": 36,
        "letterSpacing": -0.3
      },
      "Heading/H1": {
        "size": 24,
        "weight": 600,
        "lineHeight": 32,
        "letterSpacing": -0.2
      },
      "Heading/H2": {
        "size": 18,
        "weight": 600,
        "lineHeight": 26,
        "letterSpacing": 0
      },
      "Heading/H3": {
        "size": 15,
        "weight": 600,
        "lineHeight": 22,
        "letterSpacing": 0
      },
      "Body/Regular": {
        "size": 14,
        "weight": 400,
        "lineHeight": 20,
        "letterSpacing": 0
      },
      "Body/Strong": {
        "size": 14,
        "weight": 500,
        "lineHeight": 20,
        "letterSpacing": 0
      },
      "Caption/Regular": {
        "size": 12,
        "weight": 400,
        "lineHeight": 16,
        "letterSpacing": 0
      },
      "Caption/Strong": {
        "size": 12,
        "weight": 500,
        "lineHeight": 16,
        "letterSpacing": 0
      },
      "Label/Overline": {
        "size": 11,
        "weight": 600,
        "lineHeight": 16,
        "letterSpacing": 0.6
      }
    }
  },
  "$aliases": {
    "status/good*": "status/normal*",
    "status/neutral*": "status/offline*"
  }
}
